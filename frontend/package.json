{
  "name": "railconnect",
  "version": "1.0.0",
  "description": "IRCTC-style Train Reservation System with User & Admin Portal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "cd server && npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx,ts,tsx",
    "lint:fix": "eslint . --ext js,jsx,ts,tsx --fix",
    "start": "node start.cjs",
    "setup": "npm install && cd server && npm install"
  },
  "dependencies": {
