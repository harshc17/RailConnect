    "jspdf": "^3.0.3",
    "lucide-react": "^0.263.1",
    "railconnect": "file:..",
    "react": "^18.2.0",
    "react-datepicker": "^4.16.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "recharts": "^3.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-datepicker": "^4.19.4",
    "@types/react-dom": "^18.2.7",
